# ============================================================
# Production deployment env file for docker-compose.yml.
# Copy to `.env` on the VPS (never commit the real .env) and fill in every
# value below. docker-compose reads this file directly for ${VAR}
# substitution, and passes it whole to the backend container via env_file.
# ============================================================

# Note: there's no DOMAIN var here anymore -- Caddy is now a separate,
# shared instance (see infra/edge/) that isn't tied to this project's own
# .env. Set your real domain directly in infra/edge/Caddyfile's site block
# instead. Its DNS A record must already point at this VPS's IP before
# Caddy can get a TLS certificate for it.

# Baked into the frontend's browser bundle at BUILD time (see
# frontend/Dockerfile and lib/api.js) -- must be the same public domain
# above, since the browser calls this URL directly. Changing it later
# requires rebuilding the frontend image, not just restarting the container.
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Everything below mirrors backend/.env.example, unchanged in shape ---

PORT=3001
NODE_ENV=production

DATABASE_PATH=/app/data/botimi.db

JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Pesepay -- switch PESEPAY_ENV to "production" and use live keys once
# you're ready to accept real payments, not before.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_ENV=sandbox

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

APP_NAME=botimi

# ============================================================
# Litestream -- continuous SQLite replication to S3-compatible object
# storage (Contabo Object Storage, Backblaze B2, AWS S3, Cloudflare R2, all
# work). Leave blank to skip backups for now, but the litestream container
# will restart-loop with an auth error rather than silently doing nothing --
# check `docker compose logs litestream` if backups matter and it's not
# running clean.
# ============================================================
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=us-east-1
