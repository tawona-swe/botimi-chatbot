# Server
PORT=3001
NODE_ENV=development

# Database (SQLite — file path)
DATABASE_PATH=./data/botimi.db

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d

# Groq API (free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (free tier: https://aistudio.google.com) — used for
# chat fallback and as the primary embeddings provider.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — free-tier models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenCode Zen (https://opencode.ai/zen) — the "*-free" models work on a
# bare key; premium models need a payment method on the workspace.
OPENCODE_ZEN_API_KEY=sk-your_opencode_zen_api_key_here

# WhatsApp Business Cloud API — from your Meta app dashboard. The webhook
# needs a public HTTPS URL (not localhost) to verify.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Pesepay (billing — Ecocash for Zimbabwe, Visa/Mastercard internationally)
# get keys from dashboard.pesepay.com "Your Test Keys" panel for sandbox,
# or the live keys panel for production.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_ENV=sandbox

# Email (Resend recommended: https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@botimi.ai

# Frontend URL (for CORS on authenticated dashboard routes)
FRONTEND_URL=http://localhost:3000
# Backend URL — must be a public HTTPS URL in production for Pesepay's resultUrl callback
BACKEND_URL=http://localhost:3001

# App
APP_NAME=botimi
